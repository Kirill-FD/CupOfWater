<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="22dp"
    android:background="@drawable/water_widget_card_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CupOfWater"
                android:textColor="#5B7184"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Сегодня"
                android:textColor="#0E2235"
                android:textSize="18sp"
                android:textStyle="normal" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvStreak"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/water_widget_streak_bg"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="7"
            android:textColor="#FF8A3D"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageView
        android:id="@+id/ivWaterProgress"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:clickable="false"
        android:contentDescription="@string/water_widget_progress_description"
        android:focusable="false"
        android:scaleType="fitCenter" />

    <ImageView
        android:id="@+id/ivWeekBars"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginBottom="14dp"
        android:contentDescription="@string/water_widget_week_description"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:weightSum="3">

        <TextView
            android:id="@+id/btnAdd200"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/water_widget_chip_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="+200 мл"
            android:textColor="#0288D1"
            android:textSize="13sp"
            android:textStyle="normal" />

        <TextView
            android:id="@+id/btnAdd250"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/water_widget_button_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="+250 мл"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="normal" />

        <TextView
            android:id="@+id/btnAdd500"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/water_widget_chip_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="+500 мл"
            android:textColor="#0288D1"
            android:textSize="13sp"
            android:textStyle="normal" />
    </LinearLayout>

</LinearLayout>
